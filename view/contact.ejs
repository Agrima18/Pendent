<!DOCTYPE html>
<html lang="en">

<head>

<title>Emergency Contacts</title>


<!-- Bootstrap -->
<link 
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">


<!-- Font Awesome -->
<link 
rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


<link rel="stylesheet" href="/css/style.css">


<style>


body{

    min-height:100vh;

    background-image:
    linear-gradient(
        rgba(0,0,0,0.35),
        rgba(0,0,0,0.35)
    ),
    url("/CONTACT.jpg");
    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;
    background-attachment:fixed;
    display:flex;
    justify-content:center;
    align-items:center;
    font-family:'Segoe UI',sans-serif;
}


/* MAIN GLASS */

.glass-box{

    width:520px;

    padding:35px;

    border-radius:25px;


    background:
    rgba(255,255,255,0.18);


    backdrop-filter:blur(15px);

    -webkit-backdrop-filter:blur(15px);


    border:
    1px solid rgba(255,255,255,0.35);



    box-shadow:
    0 8px 32px
    rgba(0,0,0,0.25);


}





h2,h4{

    text-align:center;

    color:white;

    font-weight:700;

}




.form-label{

    color:white;

    font-weight:600;

}





.form-control{


    background:
    rgba(255,255,255,0.25);


    border:none;

    border-radius:15px;


    color:white;

    padding:12px;


}



.form-control::placeholder{

    color:#eee;

}



.form-control:focus{

    background:
    rgba(255,255,255,0.35);

    box-shadow:none;

    color:white;

}




.save-btn{


    border-radius:20px;

    padding:12px;

    background:#111;

    color:white;

}




.contact-card{


    margin-top:15px;

    padding:18px;

    border-radius:20px;


    background:
    rgba(255,255,255,0.25);


    backdrop-filter:blur(10px);


    color:white;

}




.call-btn{


    border-radius:20px;

}



.back-btn{


    color:white;

    text-decoration:none;

}



i{

    margin-right:8px;

}


</style>


</head>





<body>



<div class="glass-box">





<h2>

<i class="fa-solid fa-address-book"></i>
Emergency Contacts

</h2>





<form action="/add-contact" method="POST">





<div class="mb-3">


<label class="form-label">

<i class="fa-solid fa-user"></i>
Person Name

</label>


<input
type="text"
name="name"
class="form-control"
placeholder="Enter person name"
required>


</div>








<div class="mb-3">


<label class="form-label">

<i class="fa-solid fa-phone"></i>
Mobile Number

</label>


<input
type="tel"
name="phone"
class="form-control"
placeholder="Enter mobile number"
required>


</div>









<div class="mb-3">


<label class="form-label">

<i class="fa-solid fa-users"></i>
Relation

</label>


<input
type="text"
name="relation"
class="form-control"
placeholder="Father / Mother / Guardian"
required>


</div>







<button class="btn save-btn w-100">


<i class="fa-solid fa-floppy-disk"></i>
Save Contact


</button>




</form>






<hr>



<h4>

<i class="fa-solid fa-list"></i>
Saved Contacts

</h4>







<% if(contacts.length===0){ %>


<p class="text-center text-white">

No contacts added

</p>


<% } %>








<% contacts.forEach(contact=>{ %>



<div class="contact-card">



<h5>

<i class="fa-solid fa-user"></i>

<%= contact.name %>


</h5>



<p>

<i class="fa-solid fa-phone"></i>

<%= contact.phone %>


</p>




<p>

<i class="fa-solid fa-heart"></i>

<%= contact.relation %>


</p>




<a 
href="tel:<%=contact.phone%>"
class="btn btn-success call-btn">


<i class="fa-solid fa-phone-volume"></i>

Call Now


</a>



</div>



<% }) %>






<div class="text-center mt-3">


<a href="/dashboard" class="back-btn">


<i class="fa-solid fa-arrow-left"></i>

Back Dashboard


</a>


</div>






</div>



</body>


</html>