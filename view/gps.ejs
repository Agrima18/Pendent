<!DOCTYPE html>
<html lang="en">

<head>

<title>Child Health Monitor</title>


<link
rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>



<style>


*{

margin:0;
padding:0;
box-sizing:border-box;

}



body{

min-height:100vh;

font-family:"Segoe UI",Arial;


background:

linear-gradient(
rgba(0,0,0,.55),
rgba(0,0,0,.55)
),

url("/HEALTH1.png");


background-size:cover;

background-position:center;

background-attachment:fixed;


}




.dashboard{

padding:35px;

}




h1{

text-align:center;

color:white;

font-size:35px;

margin-bottom:35px;


text-shadow:

0 0 25px #00eaff;

}



h1 i{

color:red;

}





.cards{


display:grid;


grid-template-columns:

repeat(auto-fit,minmax(240px,1fr));


gap:25px;


}







.card{


height:190px;


border-radius:30px;


background:

rgba(255,255,255,.15);


backdrop-filter:

blur(20px);



border:

1px solid rgba(255,255,255,.35);



box-shadow:

0 8px 35px black;



display:flex;


flex-direction:column;


align-items:center;


justify-content:center;


transition:.3s;


}



.card:hover{


transform:

translateY(-10px);


box-shadow:

0 0 35px #00eaff;


}




.card i{


font-size:38px;

color:#00eaff;


margin-bottom:15px;


}





.card h3{

color:#ddd;

font-size:17px;


}



.card h2{

color:white;

font-size:22px;

margin-top:10px;

text-align:center;

}





.graph{


margin:

35px auto;


width:90%;


height:350px;


padding:25px;



border-radius:30px;



background:

rgba(255,255,255,.15);



backdrop-filter:

blur(20px);



box-shadow:

0 0 35px cyan;


}



canvas{

height:100%!important;

}




.back{


display:block;


margin:

30px auto;



width:180px;

height:50px;


border:none;


border-radius:30px;



background:

rgba(255,255,255,.2);



color:white;


font-size:18px;



box-shadow:

0 0 20px cyan;



cursor:pointer;


}



.back:hover{

transform:scale(1.1);

}



</style>



</head>






<body>




<div class="dashboard">



<h1>

<i class="fa-solid fa-heart-pulse"></i>

 CHILD HEALTH AI


</h1>






<div class="cards">







<div class="card">


<i class="fa-solid fa-location-dot"></i>


<h3>

GPS


</h3>



<h2>


LAT:

<span id="lat">

--

</span>


<br>


LON:

<span id="lon">

--

</span>


</h2>



</div>









<div class="card">


<i class="fa-solid fa-person-running"></i>


<h3>

Accelerometer


</h3>



<h2>


X:

<span id="accX">

--

</span>


<br>


Y:

<span id="accY">

--

</span>


<br>


Z:

<span id="accZ">

--

</span>



</h2>




</div>










<div class="card">


<i class="fa-solid fa-wave-square"></i>


<h3>


Movement


</h3>



<h2 id="movement">


--


</h2>



</div>









<div class="card">



<i class="fa-solid fa-shield-heart"></i>



<h3>


Health Status


</h3>




<h2 id="status">


Checking...


</h2>




</div>






</div>








<div class="graph">



<canvas id="heartChart">


</canvas>



</div>









<button

onclick="history.back()"

class="back">


⬅ BACK


</button>





</div>









<script>



let labels=[];


let values=[];





let chart =

new Chart(

document.getElementById("heartChart"),

{


type:"line",



data:{


labels:labels,


datasets:[

{


label:"Motion Magnitude",

data:values,


tension:.4



}

]


}



}

);










async function updateHealth(){



try{



let res =

await fetch("/api/esp");



let data =

await res.json();




console.log(data);





// GPS


lat.innerHTML =

data.LAT;



lon.innerHTML =

data.LON;





// ACCELEROMETER



accX.innerHTML =

data.X;



accY.innerHTML =

data.Y;



accZ.innerHTML =

data.Z;







// calculate movement



let motion =

Math.sqrt(

(data.X*data.X)+

(data.Y*data.Y)+

(data.Z*data.Z)

);




movement.innerHTML =

motion.toFixed(0);








// graph update



labels.push(

new Date()

.toLocaleTimeString()

);



values.push(

motion.toFixed(0)

);





if(labels.length>10)

{


labels.shift();


values.shift();


}





chart.update();








// fall detection



if(motion>25000)

{


status.innerHTML =

"FALL ALERT 🔴";


}



else{


status.innerHTML =

"SAFE 🟢";


}




}





catch(err){



console.log(err);



status.innerHTML =

"DEVICE OFFLINE 🔴";



}



}







setInterval(

updateHealth,

1000

);



updateHealth();



</script>




</body>


</html>